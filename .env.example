# =============================================================================
# Workeva web app - environment configuration
#
# Copy to .env.local (git-ignored). Everything here is prefixed NEXT_PUBLIC_ and
# is therefore shipped to the browser - so ONLY values that are safe in public
# belong in this file.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY, BREVO_API_KEY, a database URL or a JWT
# secret here. Those live on the API host only (workeva-backend/.env.example).
# =============================================================================

# Base URL of the Workeva ASP.NET Core API, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Supabase project URL and anon (public) key - Project Settings > API.
# The anon key is designed to be public; Row Level Security governs what it reaches.
NEXT_PUBLIC_SUPABASE_URL=https://yourprojectref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
